{
  "name": "look-up",
  "private": true,
  "description": "Look Up — tap to identify a radio ad and get the station's buttons",
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/portal"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "database:create-roles": "npm run database:create-roles -w @lookup/api",
    "database:migrate": "npm run database:migrate -w @lookup/api",
    "object-storage:prepare": "npm run object-storage:prepare -w @lookup/api",
    "database:seed": "npm run database:seed -w @lookup/api",
    "development:show-recognitions": "npm run development:show-recognitions -w @lookup/api",
    "development:set-station-status": "npm run development:set-station-status -w @lookup/api --",
    "development:set-campaign-status": "npm run development:set-campaign-status -w @lookup/api --",
    "development:reset-sample-schedule": "npm run development:reset-sample-schedule -w @lookup/api --",
    "build:contracts": "npm run build -w @lookup/contracts",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "check:requirements": "node scripts/check-requirement-evidence.mjs",
    "workers": "node scripts/run-fingerprint-workers.mjs",
    "deploy:new-secrets": "node scripts/make-deploy-secrets.mjs",
    "deploy:email-address": "node scripts/make-email-address.mjs"
  }
}
