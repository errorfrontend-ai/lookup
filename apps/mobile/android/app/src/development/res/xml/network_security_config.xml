<?xml version="1.0" encoding="utf-8"?>
<!-- Development flavour only: plain http to the PC as the emulator sees it (10.0.2.2) and to this
     device itself, for the local API and the fake API. Everything else stays https. The user's phone
     uses the https tunnel (design S4-D30). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
