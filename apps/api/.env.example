# Copy to .env for local development. Values match infra/docker-compose.yml.
# Generate real passwords (16+ characters); never commit .env.
NODE_ENV=development
PORT=3100

# The API connects as lookup_api. It refuses to start as an owner, a superuser or a role that bypasses row-level security.
DATABASE_URL=postgresql://lookup_api:CHANGE_ME_API_PASSWORD@127.0.0.1:55432/lookup
DATABASE_STATEMENT_TIMEOUT_MILLISECONDS=5000
# Encrypt the database connection: disable | require | verify-full. Production refuses "disable".
DATABASE_TLS_MODE=disable

# Used only by `npm run database:create-roles` and `npm run database:migrate` (never by the running API).
DATABASE_SETUP_URL=postgresql://lookup:lookup_development_only@127.0.0.1:55432/lookup
LOOKUP_API_DATABASE_PASSWORD=CHANGE_ME_API_PASSWORD
LOOKUP_ADMIN_API_DATABASE_PASSWORD=CHANGE_ME_ADMIN_API_PASSWORD
LOOKUP_FINGERPRINT_WORKER_DATABASE_PASSWORD=CHANGE_ME_FINGERPRINT_WORKER_PASSWORD

# Valkey: job queues, rate-limit counters, short-lived codes. Local password matches infra/docker-compose.yml.
KEY_VALUE_STORE_URL=redis://:lookup_key_value_development_only@127.0.0.1:46379

# At least 32 random bytes, base64url (43+ characters). Signs access tokens and trusted-device cookies.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
AUTHENTICATION_SECRET=CHANGE_ME_TO_43_OR_MORE_BASE64URL_CHARACTERS_FROM_32_RANDOM_BYTES

# Object storage for ad uploads (versitygw locally, Cloudflare R2 in production).
# ENDPOINT is how the API reaches it; PUBLIC_ENDPOINT is what browsers reach (presigned URLs are signed for that host).
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:39000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:39000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=lookup_development_only
OBJECT_STORAGE_SECRET_ACCESS_KEY=lookup_object_storage_development_only
OBJECT_STORAGE_AD_UPLOADS_BUCKET=lookup-ad-uploads

# Development seed (npm run database:seed): Station A's owner. The password must meet the policy (15+ characters).
SEED_OWNER_EMAIL=owner@station-a.example
SEED_OWNER_PASSWORD=CHANGE_ME_choose-a-long-passphrase

LOG_LEVEL=info
# Full request details in logs (may include personal data). Keep false unless debugging locally.
LOG_REQUEST_DETAILS=false

# Browser origins allowed to call the API with cookies (comma-separated). Production: https only.
ALLOWED_BROWSER_ORIGINS=http://localhost:5180
# Proxies in front of the API (Render: 1). A wrong value lets clients fake their address.
TRUSTED_PROXY_COUNT=1
# Baseline requests per client address per minute, on every route. Sign-in and similar routes are stricter.
RATE_LIMIT_REQUESTS_PER_MINUTE=300

# Listener app (Step 3). Two more random secrets, each different from AUTHENTICATION_SECRET:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
LISTENER_INSTALL_TOKEN_SECRET=CHANGE_ME_INSTALL_TOKEN_SECRET_43_CHARACTERS_OR_MORE
LISTENER_INSTALL_ID_PEPPER=CHANGE_ME_INSTALL_ID_PEPPER_43_CHARACTERS_OR_MORE_____

# Clips sent later, the update gate and re-registration (P4 design §5.11). The defaults are the plan's example
# numbers until the P8 load test sets them. LISTENER_MINIMUM_APP_VERSION=0.0.0 switches the update gate off.
LISTENER_MINIMUM_APP_VERSION=0.0.0
RECOGNITIONS_DEFERRED_PER_INSTALL_PER_HOUR=10
RECOGNITION_DEFERRED_QUEUE_DEPTH_LIMIT=20
RECOGNITION_DEFERRED_WAIT_MILLISECONDS=5000
RECOGNITION_DEFERRED_RETRY_AFTER_MINIMUM_SECONDS=60
RECOGNITION_DEFERRED_RETRY_AFTER_MAXIMUM_SECONDS=300
RECOGNITIONS_DEFERRED_IN_FLIGHT_LIMIT=16
RECOGNITION_REPLAYS_PER_INSTALL_PER_HOUR=60
RECOGNITION_IDEMPOTENCY_KEY_CLEAN_UP_INTERVAL_SECONDS=86400
LISTENER_REREGISTRATIONS_PER_INSTALL_PER_DAY=5
# Button taps (P4 design §5.8): taps one phone may count toward one campaign's tap limit in 24 hours; 0 = no cap.
ENGAGEMENTS_COUNTED_PER_INSTALL_PER_CAMPAIGN_PER_DAY=5
# Station sign-up, review, the super admin's second factor and the team (phase 5a, docs/design/step-5a-registration-and-admin.md).
# The super-admin endpoints connect as lookup_admin_api (its password is LOOKUP_ADMIN_API_DATABASE_PASSWORD above).
ADMIN_DATABASE_URL=postgresql://lookup_admin_api:CHANGE_ME_ADMIN_API_PASSWORD@127.0.0.1:55432/lookup
# Encrypts super admins' second-factor secrets; one more random secret, different from every other one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TWO_FACTOR_ENCRYPTION_SECRET=CHANGE_ME_TWO_FACTOR_SECRET_43_CHARACTERS_OR_MORE____
# Private buckets for licence documents and station logos (created by the test set-up and the development tools).
OBJECT_STORAGE_LICENCE_DOCUMENTS_BUCKET=lookup-licence-documents
OBJECT_STORAGE_STATION_LOGOS_BUCKET=lookup-station-logos
# The portal's address, for links in emails. Production: https.
PORTAL_PUBLIC_ORIGIN=http://localhost:5180
# Email goes to Mailpit on this machine (inbox at http://127.0.0.1:8025). Production: smtps://, or smtp:// with
# EMAIL_SMTP_REQUIRE_TLS=true.
EMAIL_SMTP_URL=smtp://127.0.0.1:1025
EMAIL_SMTP_REQUIRE_TLS=false
EMAIL_FROM_ADDRESS=Look Up <no-reply@lookup.invalid>
# SMS: "development" delivers each SMS as an email to the same inbox; "none" keeps sign-up closed. Production refuses
# "development", and no real provider is built yet (O16).
SMS_SENDER=development
NOTIFICATION_SENDING_ENABLED=true
# Cloudflare Turnstile's secret key. This one is Cloudflare's always-pass test key; production refuses the test keys.
HUMAN_CHECK_SECRET_KEY=1x0000000000000000000000000000000AA
# Development seed (npm run database:seed): a super admin for the console, when set. Its authenticator secret is
# fixed here (base32, 32 characters or more), so the authenticator app set up once keeps working after each re-seed:
#   node -e "const b=require('node:crypto').randomBytes(20);let s='',v=0,n=0;for(const x of b){v=v<<8|x;n+=8;while(n>=5){s+='ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'[(v>>>(n-5))&31];n-=5}}console.log(s)"
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_TWO_FACTOR_SECRET=
