    "longest_honoured_retry_after_seconds": 3600,
    "backoff_first_wait_seconds": 30,
    "backoff_longest_wait_seconds": 1800,
    "backoff_lowest_jitter_factor": 0.5,
    "registrations_after_refused_token_per_run": 1,
