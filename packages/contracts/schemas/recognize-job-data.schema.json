{
  "$id": "https://contracts.lookup.invalid/recognize-job-data/1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RecognizeJobData",
  "$defs": {
    "RecognizeJobData": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "audio_base64": {
          "type": "string",
          "minLength": 1
        },
        "codec": {
          "type": "string",
          "enum": [
            "aac",
            "opus"
          ]
        },
        "deadline_epoch_milliseconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fingerprint_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "request_id",
        "audio_base64",
        "codec",
        "deadline_epoch_milliseconds",
        "fingerprint_version"
      ],
      "additionalProperties": false
    }
  }
}
