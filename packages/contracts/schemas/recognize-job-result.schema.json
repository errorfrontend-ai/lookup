{
  "$id": "https://contracts.lookup.invalid/recognize-job-result/1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RecognizeJobResult",
  "$defs": {
    "RecognizeJobResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "MATCH",
            "AMBIGUOUS",
            "NO_MATCH",
            "EXPIRED"
          ]
        },
        "audio_asset_number": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "aligned_hash_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "match_margin": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "match_offset_milliseconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "audio_asset_number",
        "aligned_hash_count",
        "match_margin",
        "match_offset_milliseconds"
      ],
      "additionalProperties": false
    }
  }
}
