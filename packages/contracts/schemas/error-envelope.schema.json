{
  "$id": "https://contracts.lookup.invalid/error-envelope/1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ErrorEnvelope",
  "$defs": {
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "fields": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "$ref": "#/$defs/FieldProblem"
              }
            }
          },
          "required": [
            "code",
            "message",
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "FieldProblem": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 120
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "path",
        "code"
      ],
      "additionalProperties": false
    }
  }
}
