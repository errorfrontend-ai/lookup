{
  "$id": "https://contracts.lookup.invalid/create-listener-account-input/1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CreateListenerAccountInput",
  "$defs": {
    "CreateListenerAccountInput": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "ticket": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{20,300}$"
        },
        "gender": {
          "type": "string",
          "enum": [
            "FEMALE",
            "MALE",
            "ANOTHER",
            "PREFER_NOT_TO_SAY"
          ]
        },
        "age": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "consent_text_version": {
          "type": "string",
          "const": "listener-consent-2026-10"
        }
      },
      "required": [
        "email",
        "ticket",
        "gender",
        "age",
        "consent_text_version"
      ],
      "additionalProperties": false
    }
  }
}
