{
  "$id": "https://contracts.lookup.invalid/refingerprint-job-data/1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RefingerprintJobData",
  "$defs": {
    "RefingerprintJobData": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "audio_asset_number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "download_address": {
          "type": "string",
          "maxLength": 4096,
          "format": "uri"
        },
        "deadline_epoch_milliseconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fingerprint_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "request_id",
        "audio_asset_number",
        "download_address",
        "deadline_epoch_milliseconds",
        "fingerprint_version"
      ],
      "additionalProperties": false
    }
  }
}
