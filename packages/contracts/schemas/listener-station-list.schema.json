{
  "$id": "https://contracts.lookup.invalid/listener-station-list/1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ListenerStationList",
  "$defs": {
    "ListenerStationList": {
      "type": "object",
      "properties": {
        "stations": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ListenerStation"
          }
        }
      },
      "required": [
        "stations"
      ],
      "additionalProperties": false
    },
    "ListenerStation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "frequency_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "city": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "logo": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicImage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "frequency_label",
        "city",
        "logo"
      ],
      "additionalProperties": false
    },
    "PublicImage": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
        },
        "width_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "address",
        "width_pixels",
        "height_pixels",
        "size_bytes"
      ],
      "additionalProperties": false
    }
  }
}
