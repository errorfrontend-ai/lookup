{
  "meta": {
    "name": "Look Up design tokens",
    "version": "0.1.0",
    "status": "Draft from the wireframe stage. The copper accent is a placeholder until a brand identity exists.",
    "consumers": "Generates the portal's Tailwind theme and the Flutter app's ThemeExtension (generator added when those apps are scaffolded).",
    "contrast": "Every text/background pair below meets WCAG AA (>= 4.5:1) in its own mode."
  },
  "color": {
    "light": {
      "ground": "#F5F2EE",
      "surface": "#FFFFFF",
      "ink": "#1C1917",
      "muted": "#57534E",
      "line": "#D6D3D1",
      "lineSoft": "#E7E2DC",
      "accent": "#A8431A",
      "accentHover": "#7C2F10",
      "onAccent": "#FFFFFF",
      "accentSoft": "#F6E7DF",
      "success": "#166534",
      "successSoft": "#E3F1E7",
      "warning": "#92400E",
      "warningSoft": "#FBEFD9",
      "danger": "#B91C1C",
      "dangerSoft": "#FBE4E4",
      "focus": "#1D4ED8"
    },
    "dark": {
      "ground": "#171412",
      "surface": "#211D1A",
      "ink": "#F5F2EE",
      "muted": "#B8B1AA",
      "line": "#3A3431",
      "lineSoft": "#2C2724",
      "accent": "#E07A4F",
      "accentHover": "#EC9670",
      "onAccent": "#1C1917",
      "accentSoft": "#3B2419",
      "success": "#6FCF8E",
      "successSoft": "#1B3324",
      "warning": "#F2B45A",
      "warningSoft": "#3A2A12",
      "danger": "#F08A8A",
      "dangerSoft": "#3D1E1E",
      "focus": "#93B4FF"
    }
  },
  "font": {
    "display": "\"Bricolage Grotesque\", system-ui, sans-serif",
    "body": "\"Public Sans\", system-ui, sans-serif",
    "note": "The Android app may map both to the system font to keep the APK small; decide before Phase 6."
  },
  "type": {
    "display": { "size": 30, "line": 36, "weight": 700, "family": "display" },
    "title":   { "size": 24, "line": 30, "weight": 700, "family": "display" },
    "heading": { "size": 18, "line": 24, "weight": 600, "family": "body" },
    "body":    { "size": 16, "line": 24, "weight": 400, "family": "body" },
    "label":   { "size": 14, "line": 20, "weight": 600, "family": "body" },
    "caption": { "size": 13, "line": 18, "weight": 500, "family": "body" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "14": 56 },
  "radius": { "sm": 6, "md": 10, "lg": 16, "xl": 24, "pill": 999 },
  "size": {
    "touchMinApp": 48,
    "touchMinWeb": 44,
    "touchGapMin": 8,
    "listRowStation": 56,
    "bannerAspect": "2:1"
  },
  "breakpoint": {
    "app": { "compact": 0, "medium": 600, "expanded": 840 },
    "web": { "sm": 375, "md": 768, "lg": 1024, "xl": 1280 }
  },
  "motion": { "fast": 150, "base": 200, "slow": 300, "respectReducedMotion": true }
}
